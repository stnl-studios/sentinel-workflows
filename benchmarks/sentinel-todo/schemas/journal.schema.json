{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/benchmark-journal-v1.json",
  "title": "Sentinel Benchmark Journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkVersion", "benchmarkId", "caseId", "runMode", "sentinelSha", "productionProfileId", "status", "abortReason", "events"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "benchmarkVersion": { "const": 1 },
    "benchmarkId": { "const": "sentinel-todo" },
    "caseId": { "enum": ["A", "B", "C"] },
    "runMode": { "enum": ["focal", "case", "full"] },
    "sentinelSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "productionProfileId": { "enum": ["production-v1", "production-v2"] },
    "status": { "enum": ["ACTIVE", "ABORTED_BUDGET"] },
    "abortReason": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "budget", "limit", "observed", "eventIndex"],
          "properties": {
            "code": { "const": "BUDGET_EXCEEDED" },
            "budget": { "type": "string" },
            "limit": { "type": "integer", "minimum": 1 },
            "observed": { "type": "integer", "minimum": 1 },
            "eventIndex": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "model", "effort"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "model": { "enum": ["GPT-5.6-Sol", "GPT-5.6-Terra", "GPT-5.6-Luna"] },
        "effort": { "enum": ["low", "medium", "high", "xhigh"] }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "operation", "phase", "model", "effort", "result", "childDispatches"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "operation": { "enum": ["SPEC_INIT", "SPEC_READINESS", "PLAN", "REVIEW_PLAN", "MATERIALIZE_TASKS", "REVIEW_TASKS", "EXECUTE_SLICE", "VALIDATE_SLICE", "APPLY_FINDINGS", "REPLAN", "SPEC_CLOSE"] },
        "phase": { "enum": ["SPEC", "PLAN", "TASKS", "EXECUTE", "REVIEW_VALIDATE"] },
        "model": { "enum": ["GPT-5.6-Sol", "GPT-5.6-Terra", "GPT-5.6-Luna"] },
        "effort": { "enum": ["low", "medium", "high", "xhigh"] },
        "result": { "enum": ["PASS", "FAIL", "BLOCKED", "NEEDS_FIX", "REJECTED", "COMPLETE"] },
        "slice": { "type": "string", "pattern": "^slice-[0-9]{2,}$" },
        "round": { "type": "integer", "minimum": 1 },
        "resultingState": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "inputBytes": { "type": "integer", "minimum": 0 },
        "outputBytes": { "type": "integer", "minimum": 0 },
        "handoffBytes": { "type": "integer", "minimum": 0 },
        "observableReads": { "type": "integer", "minimum": 0 },
        "mechanicalRejection": { "type": "boolean" },
        "retry": { "type": "boolean" },
        "escalation": { "type": "boolean" },
        "childDispatches": { "type": "array", "items": { "$ref": "#/$defs/dispatch" } }
      }
    }
  }
}
