{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/stnl-runner-execute-response-v1.json",
  "$comment": "Native transport schema: each execution or findings response owns its explicit admitted automaticCheckRound.",
  "title": "Sentinel EXECUTE_SLICE semantic response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "head",
    "discoverySources",
    "discoveryActions",
    "verificationTypesConsidered",
    "nonApplicabilityRationale",
    "noVerificationCommandConfirmation",
    "commands",
    "resultOfEachCommandAndExitCode",
    "selectedChecks",
    "selectionRationale",
    "coverage",
    "failures",
    "priorRoundFailure",
    "correctionApplied",
    "inSliceRationale",
    "evidenceOrFailureSummary",
    "affectedFilesOrBehaviors",
    "blockers",
    "unexpectedWorkspaceEffects",
    "persistenceSummary",
    "automaticCheckRound"
  ],
  "properties": {
    "status": {
      "enum": [
        "TESTS_PASS",
        "TESTS_FAIL",
        "TESTS_NOT_APPLICABLE",
        "BLOCKED"
      ]
    },
    "automaticCheckRound": {
      "type": "string",
      "enum": [
        "1/3",
        "2/3",
        "3/3"
      ],
      "description": "Explicit admitted native invocation round."
    },
    "head": {
      "type": "string",
      "pattern": "^[^\\r\\n`]+$"
    },
    "discoverySources": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "discoveryActions": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "verificationTypesConsidered": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "nonApplicabilityRationale": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "noVerificationCommandConfirmation": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "commands": {
      "description": "Non-authoritative semantic check claims; the producer binds exact commands and exits to official verification observations.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit"
        ],
        "properties": {
          "command": {
            "type": "string",
            "pattern": "^[\\s\\S]+$"
          },
          "exit": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "resultOfEachCommandAndExitCode": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "selectedChecks": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "selectionRationale": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "coverage": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "failures": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "priorRoundFailure": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "correctionApplied": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "inSliceRationale": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "evidenceOrFailureSummary": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "affectedFilesOrBehaviors": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "blockers": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "unexpectedWorkspaceEffects": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "persistenceSummary": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "filelessReason": {
      "type": "string",
      "pattern": "^[\\s\\S]+$"
    },
    "testCoverageOmissions": {
      "description": "Independent, origin-bound attestation of an existing prepared-test omission. Not formal findings or a new judgment; current producer must authenticate scope, obligation and observed file bytes before correction.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligationId",
          "testPath",
          "testedFileSha256",
          "evidence",
          "expectedCorrection"
        ],
        "properties": {
          "obligationId": {
            "type": "string",
            "pattern": "^obligation-[0-9]{2,}$"
          },
          "testPath": {
            "type": "string",
            "minLength": 1
          },
          "testedFileSha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "expectedCorrection": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "testCoverageOmissions"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          },
          "commands": {
            "minItems": 1,
            "items": {
              "properties": {
                "exit": {
                  "const": 0
                }
              }
            }
          }
        }
      }
    }
  ]
}
