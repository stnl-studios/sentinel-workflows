{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/stnl-runner-apply-findings-response-v1.json",
  "title": "Sentinel APPLY_FINDINGS semantic response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status", "automaticCheckRound", "findingsCycle", "head", "discoverySources", "discoveryActions",
    "verificationTypesConsidered", "nonApplicabilityRationale", "noVerificationCommandConfirmation",
    "commands", "resultOfEachCommandAndExitCode", "selectedChecks", "selectionRationale", "coverage",
    "findingsVerified", "correctionsCovered", "regressionsSelected", "unsupportedActiveFindings", "failures",
    "evidenceOrFailureSummary",
    "affectedFilesOrBehaviors", "blockers", "unexpectedWorkspaceEffects", "persistenceSummary"
  ],
  "properties": {
    "status": { "enum": ["TESTS_PASS", "TESTS_FAIL", "TESTS_NOT_APPLICABLE", "BLOCKED"] },
    "automaticCheckRound": { "enum": ["1/3", "2/3", "3/3"] },
    "findingsCycle": { "type": "string", "pattern": "^[^\\r\\n`]+$" },
    "head": { "type": "string", "pattern": "^[^\\r\\n`]+$" },
    "discoverySources": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "discoveryActions": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "verificationTypesConsidered": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "nonApplicabilityRationale": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "noVerificationCommandConfirmation": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "commands": {
      "description": "Non-authoritative semantic check claims; exact command and exit come from marked SDK command_execution events.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit"],
        "properties": {
          "command": { "type": "string", "pattern": "^[\\s\\S]+$" },
          "exit": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
        }
      }
    },
    "resultOfEachCommandAndExitCode": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "selectedChecks": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "selectionRationale": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "coverage": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "findingsVerified": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "correctionsCovered": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "regressionsSelected": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "unsupportedActiveFindings": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "failures": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "evidenceOrFailureSummary": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "affectedFilesOrBehaviors": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "blockers": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "unexpectedWorkspaceEffects": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "persistenceSummary": { "type": "string", "pattern": "^[\\s\\S]+$" },
    "filelessReason": { "type": "string", "pattern": "^[\\s\\S]+$" }
  }
}
